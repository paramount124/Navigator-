{
  "manifest_version": 3,
  "name": "NavGuide Interactive Helper",
  "version": "1.0",
  "description": "Guides users step-by-step based on their goals.",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css", "driver.css"],
      "js": ["driver.js.iife.js", "content.js"]
    }
  ]
}